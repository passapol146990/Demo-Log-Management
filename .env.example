# App
NODE_ENV=development
PORT=3000

# Auth
JWT_SECRET=your-jwt-secret-here-minimum-32-characters
BCRYPT_ROUNDS=10

# OpenSearch
OPENSEARCH_URL=http://opensearch:9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=admin
OPENSEARCH_INITIAL_ADMIN_PASSWORD=admin

# Webhook (alerts)
WEBHOOK_URL=https://webhook.site/your-webhook-url-here

# Vector
VECTOR_LOG=info
VECTOR_INGEST_TOKEN=generate-with-jsonwebtoken-sub-vector-syslog-role-admin-tenant-demoA

# Tenants
TENANT_DEMO_A=demoA
TENANT_DEMO_B=demoB

# Syslog
SYSLOG_PORT=514

# Retention
LOG_RETENTION_DAYS=7

# Enrichment worker (geoip + reverse DNS)
REDIS_URL=redis://redis:6379
ENRICHMENT_INTERVAL_MS=15000
ENRICHMENT_BATCH_SIZE=100
ENRICHMENT_RATE_LIMIT_PER_SEC=100

# Alert worker check interval (fixed, not editable from the UI)
ALERT_CHECK_INTERVAL_MS=10000

# API response cache (Redis, falls back to in-memory if Redis unavailable)
SEARCH_CACHE_TTL_SECONDS=4

# SaaS deployment (Caddy reverse proxy domain) — ใช้เฉพาะตอนรันคู่กับ docker-compose.saas.yml
# ใช้ nip.io ได้ฟรีถ้ายังไม่มี domain จริง เช่น 1.2.3.4.nip.io
DOMAIN=yourdomain.com

# Cloudflare Tunnel (HTTPS) — ใช้เฉพาะ deploy/cloudflare/setup.sh และ deploy/terraform
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_ZONE_ID=your_zone_id
CLOUDFLARE_TUNNEL_ID=your_tunnel_id
