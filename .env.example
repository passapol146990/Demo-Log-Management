# App
NODE_ENV=development
PORT=3000

# Auth
JWT_SECRET=your-jwt-secret-here-minimum-32-characters
BCRYPT_ROUNDS=10

# OpenSearch
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=admin
OPENSEARCH_INITIAL_ADMIN_PASSWORD=admin

# Webhook (alerts)
WEBHOOK_URL=https://webhook.site/your-webhook-url-here

# Vector
VECTOR_LOG=info

# Tenants
TENANT_DEMO_A=demoA
TENANT_DEMO_B=demoB

# Syslog
SYSLOG_PORT=514
